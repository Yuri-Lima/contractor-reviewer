# ContractAI Review MVP+ — variáveis de ambiente (copiar para .env e preencher)

# --- Postgres (docker-compose ou externo)
POSTGRES_USER=contractai
POSTGRES_PASSWORD=contractai
POSTGRES_DB=contractai
POSTGRES_PORT=5433
DATABASE_URL=postgresql://contractai:contractai@localhost:5432/contractai
# Optional: separate vector DB (chunks, embeddings). If unset, uses DATABASE_URL.
# VECTOR_DATABASE_URL=postgresql://contractai:contractai@localhost:5432/contractai_vector

# --- Redis (BullMQ)
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380

# --- API (apps/api)
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# --- Storage (S3 ou R2; dev pode usar local)
STORAGE_TYPE=local
STORAGE_PATH=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=contractai
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Para dev local sem S3, usar implementação em disco (STORAGE_TYPE=local)

# --- Malware Scanning (opcional, futuro ClamAV)
MALWARE_SCAN_ENABLED=false

# --- OpenAI (RAG - Required for Fase 5+)
OPENAI_API_KEY=your-openai-api-key-here
# Get your API key from https://platform.openai.com/api-keys

# --- LLM output token limit (chat, redline)
# Maximum tokens the LLM can generate per response. Default: 2000. Higher values allow longer answers but increase cost.
LLM_MAX_TOKENS=2000

# --- Opcional: encryption at rest (master key para envelope encryption)
# Gerar com: openssl rand -hex 32
ENCRYPTION_MASTER_KEY=

# --- Transcription (Hugging Face inference provider)
# HF_INFERENCE_PROVIDER: hf-inference (free credits) or auto (uses your HF provider order)
HF_INFERENCE_PROVIDER=hf-inference

# --- Encryption for workspace API keys (transcription + parsers)
# PARSER_KEYS_ENCRYPTION_KEY: Required for voice transcription and optional parsers (DPT-2, LlamaParse, Unstructured).
# Stores API keys (HuggingFace, OpenAI) encrypted per workspace. Generate: openssl rand -hex 32
PARSER_KEYS_ENCRYPTION_KEY=
# URLs dos serviços Docling e PDFPlumber (self-hosted via docker-compose)
# Docling: PDF, DOCX, imagens. Suporta OCR para PDFs escaneados.
DOCLING_URL=http://localhost:8000
# PDFPlumber: PDF apenas. Extração clássica.
PDFPLUMBER_URL=http://localhost:8001
# Portas alternativas (opcional): DOCLING_PORT=8000, PDFPLUMBER_PORT=8001

# --- apps/web (URL da API)
VITE_API_URL=http://localhost:3000
# ou NG_APP_API_URL / Angular: environment.apiUrl

# --- Chat Prepare/Execute (Dev Mode LLM Payload Preview)
# Set to false in production to disable prepare/execute endpoints (returns 404)
CHAT_PREPARE_ENABLED=true

# --- Log full LLM context (system + user prompts) for debugging
# Set to true to see the exact context sent to the LLM before each generation
# LOG_LLM_PROMPT_CONTEXT=true

# --- Log level: error | warn | log | debug | verbose | off
# Production: use "warn" or "error" to reduce flow logs. Use "off" to disable.
# Development: use "debug" or "verbose" for full flow tracking.
LOG_LEVEL=debug

# --- Rate Limiting (por usuário/workspace)
# RATE_LIMIT_REQUESTS_PER_MINUTE=60
# RATE_LIMIT_REQUESTS_PER_HOUR=1000
# RATE_LIMIT_REQUESTS_PER_DAY=10000
# RATE_LIMIT_TOKENS_PER_DAY=100000

# --- Superadmin (criado automaticamente na inicialização)
SUPERADMIN_EMAIL=admin@contractai.com
SUPERADMIN_PASSWORD=superadmin
SUPERADMIN_NAME=Super Admin
SUPERADMIN_ENABLED=true
