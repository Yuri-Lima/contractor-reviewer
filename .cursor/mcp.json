{
    "mcpServers": {
      "docling": {
        "command": "uvx",
        "args": [
          "--from=docling-mcp",
          "docling-mcp-server"
        ]
      },
      "redis": {
        "command": "bash",
        "args": ["./scripts/redis-mcp.sh"]
      },
      "angular-cli": {
        "command": "npx",
        "args": [
          "-y",
          "@angular/cli",
          "mcp"
        ]
      },
      "primeng": {
        "command": "npx",
        "args": [
          "-y",
          "@primeng/mcp"
        ]
      }
    }
  }
  