# ContractAI Review — VPS deployment
# Copy to .env and fill values. Run: docker compose up -d

# =============================================================================
# DOCKER HUB (required for image pull)
# =============================================================================

DOCKERHUB_USERNAME=yurimatoslima
IMAGE_TAG=latest

# =============================================================================
# REQUIRED — App secrets
# =============================================================================

POSTGRES_USER=contractai
POSTGRES_PASSWORD=CHANGE_ME_MIN_32_CHARS
POSTGRES_DB=contractai

JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

OPENAI_API_KEY=sk-your-openai-api-key

SUPERADMIN_ENABLED=true
SUPERADMIN_EMAIL=admin@contractai.com
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SUPERADMIN_NAME=Super Admin

# =============================================================================
# OPTIONAL — Storage, parsers, ports
# =============================================================================

STORAGE_TYPE=local
STORAGE_PATH=/app/apps/api/storage

PARSER_KEYS_ENCRYPTION_KEY=

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=contractai
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

FRONTEND_URL=

# =============================================================================
# TRAEFIK / TLS
# =============================================================================

# Primary domain for the app (e.g. app.example.com)
SITE_DOMAIN=app.example.com
# Optional: root domain (e.g. example.com) to also serve the app with HTTPS.
# Set to enable https://example.com in addition to https://app.example.com
SITE_DOMAIN_ROOT=
ACME_EMAIL=admin@example.com
ACME_STAGING=false
# When ACME_STAGING=true, set ACME_CASERVER to staging URL:
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# When ACME_STAGING=false (production), leave empty or use production default

# Bind Postgres/Redis to localhost only (blocks internet scanners). Default 127.0.0.1.
# Leave unset to use default. To publish on all interfaces (not recommended), set to 0.0.0.0
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379
DOCLING_PORT=8000
PDFPLUMBER_PORT=8001
WEB_PORT=80
