# ContractAI Review MVP+ — variáveis de ambiente (copiar para .env e preencher)

# --- Postgres (docker-compose ou externo)
POSTGRES_USER=contractai
POSTGRES_PASSWORD=contractai
POSTGRES_DB=contractai
POSTGRES_PORT=5432
DATABASE_URL=postgresql://contractai:contractai@localhost:5432/contractai

# --- Redis (BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- API (apps/api)
NODE_ENV=development
PORT=3000
JWT_SECRET=change-me-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# --- Storage (S3 ou R2; dev pode usar local)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=contractai
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Para dev local sem S3, usar implementação em disco (configurar em apps/api)

# --- OpenAI (RAG)
OPENAI_API_KEY=

# --- Opcional: encryption at rest (master key para envelope encryption)
ENCRYPTION_MASTER_KEY=

# --- apps/web (URL da API)
VITE_API_URL=http://localhost:3000
# ou NG_APP_API_URL / Angular: environment.apiUrl
