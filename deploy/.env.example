# ContractAI Review — VPS deployment
# Copy to .env and fill values. Run: docker compose up -d

# =============================================================================
# DOCKER HUB (required for image pull)
# =============================================================================

DOCKERHUB_USERNAME=yurimatoslima
IMAGE_TAG=latest

# =============================================================================
# REQUIRED — App secrets
# =============================================================================

POSTGRES_USER=contractai
POSTGRES_PASSWORD=CHANGE_ME_MIN_32_CHARS
POSTGRES_DB=contractai

JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

OPENAI_API_KEY=sk-your-openai-api-key
# Pin model versions explicitly so upstream upgrades don't surprise you.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Maximum tokens the LLM can generate per response. Default: 2000.
LLM_MAX_TOKENS=2000

SUPERADMIN_ENABLED=true
SUPERADMIN_EMAIL=admin@contractai.com
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
SUPERADMIN_NAME=Super Admin

# =============================================================================
# OPTIONAL — Storage, parsers, ports
# =============================================================================

STORAGE_TYPE=local
STORAGE_PATH=/app/apps/api/storage

PARSER_KEYS_ENCRYPTION_KEY=

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=contractai
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

FRONTEND_URL=

# =============================================================================
# OPTIONAL — RAG Retrieval Tuning
# =============================================================================
# See .env.example for full descriptions of each knob.

RAG_TOP_K_DOCUMENT=8
RAG_TOP_K_LEGAL=3
RAG_SIMILARITY_FLOOR=0.5
RAG_CITATION_CAP_DOCUMENT=5
RAG_CITATION_CAP_LEGAL=2

# =============================================================================
# OBSERVABILITY / RUNTIME FLAGS
# =============================================================================

# Log level: error | warn | log | debug | verbose | off
# Production: "warn" or "error". Development: "debug" or "verbose".
LOG_LEVEL=warn

# Set to false in production to disable the dev-only chat prepare/execute
# preview endpoints (returns 404 when disabled).
CHAT_PREPARE_ENABLED=false

# =============================================================================
# TRAEFIK / TLS
# =============================================================================

# Primary domain for the app (e.g. app.example.com)
SITE_DOMAIN=app.example.com
# Optional: root domain (e.g. example.com) to also serve the app with HTTPS.
# Set to enable https://example.com in addition to https://app.example.com
SITE_DOMAIN_ROOT=
ACME_EMAIL=admin@example.com
ACME_STAGING=false
# When ACME_STAGING=true, set ACME_CASERVER to staging URL:
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
# When ACME_STAGING=false (production), leave empty or use production default

# Bind Postgres/Redis to localhost only (blocks internet scanners). Default 127.0.0.1.
# Leave unset to use default. To publish on all interfaces (not recommended), set to 0.0.0.0
POSTGRES_BIND=127.0.0.1
REDIS_BIND=127.0.0.1
POSTGRES_PORT=5432
REDIS_PORT=6379
DOCLING_PORT=8000
PDFPLUMBER_PORT=8001
WEB_PORT=80
