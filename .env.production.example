# ContractAI Review — Production environment template
# Copy to .env and fill required values before: docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# =============================================================================
# REQUIRED — Must be set for production
# =============================================================================

# Database (used by postgres container and API)
POSTGRES_USER=contractai
POSTGRES_PASSWORD=CHANGE_ME_MIN_32_CHARS
POSTGRES_DB=contractai
# DATABASE_URL is auto-constructed by docker-compose from POSTGRES_* vars

# Redis
REDIS_URL=redis://redis:6379

# JWT — Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# OpenAI (RAG) — required: powers embeddings and the default chat provider.
# Embeddings ALWAYS use OpenAI even when chat is routed through Anthropic or xAI.
OPENAI_API_KEY=sk-your-openai-api-key

# Optional alternative chat providers — set workspace `defaultLlmProvider` to switch.
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514
# XAI_API_KEY=xai-your-xai-key
# XAI_CHAT_MODEL=grok-4-1-fast-reasoning

# Superadmin (created on first start)
SUPERADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# =============================================================================
# OPTIONAL — Document Parsers
# =============================================================================

# Only if using DPT-2, LlamaParse, or Unstructured. Generate with: openssl rand -hex 32
PARSER_KEYS_ENCRYPTION_KEY=

# Self-hosted parsers (Docker internal hostnames)
DOCLING_URL=http://docling:8000
PDFPLUMBER_URL=http://pdfplumber:8001

# =============================================================================
# OPTIONAL — Storage (S3/R2)
# =============================================================================

# Use local storage (default) or s3
STORAGE_TYPE=local
STORAGE_PATH=/app/apps/api/storage

# If STORAGE_TYPE=s3:
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=contractai
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=contractai
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# =============================================================================
# OPTIONAL — API Server
# =============================================================================

NODE_ENV=production
PORT=3000
FRONTEND_URL=
# Set to public URL for CORS if different from nginx origin (e.g. https://app.example.com)

# =============================================================================
# OPTIONAL — Superadmin
# =============================================================================

SUPERADMIN_ENABLED=true
SUPERADMIN_EMAIL=admin@contractai.com
SUPERADMIN_NAME=Super Admin

# =============================================================================
# OPTIONAL — OpenAI Models
# =============================================================================

OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Maximum tokens the LLM can generate per response. Default: 2000. Higher values allow longer answers but increase cost.
LLM_MAX_TOKENS=2000

# =============================================================================
# OPTIONAL — RAG Retrieval Tuning
# =============================================================================
# See .env.example for full descriptions of each knob.
# Hot-swappable; existing cached answers age out via RAG_CACHE_TTL_SECONDS.

RAG_TOP_K_DOCUMENT=8
RAG_TOP_K_LEGAL=3
RAG_SIMILARITY_FLOOR=0.5
RAG_CITATION_CAP_DOCUMENT=5
RAG_CITATION_CAP_LEGAL=2

# =============================================================================
# OPTIONAL — Security and Encryption
# =============================================================================

MALWARE_SCAN_ENABLED=false

# =============================================================================
# OPTIONAL — Rate Limiting
# =============================================================================

RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_REQUESTS_PER_HOUR=1000
RATE_LIMIT_REQUESTS_PER_DAY=10000
RATE_LIMIT_TOKENS_PER_DAY=100000

# =============================================================================
# OPTIONAL — Observability (EventHog, Sentry, etc.)
# =============================================================================

# EventHog — add vars when integrating (e.g. EVENTHOG_API_KEY, EVENTHOG_INGEST)
# EVENTHOG_API_KEY=
# EVENTHOG_INGEST=

# Sentry error tracking
# SENTRY_DSN=

# Log verbosity: error | warn | log | info | debug | verbose | off
# Use "warn" or "error" in production to reduce flow-tracking logs
LOG_LEVEL=info

# =============================================================================
# OPTIONAL — Ports (docker-compose)
# =============================================================================

POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=80
