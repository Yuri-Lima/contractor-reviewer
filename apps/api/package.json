{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "description": "ContractAI Review — NestJS API + workers",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:worker": "nest start --entryFile worker",
    "dev": "nest start --watch",
    "migration:run": "ts-node --project tsconfig.migration.json src/run-migration.ts",
    "migration:revert": "ts-node --project tsconfig.migration.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "migration:generate": "ts-node --project tsconfig.migration.json -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:generate src/migrations/Migration -d src/data-source.ts",
    "lint": "eslint .",
    "test": "jest --config jest.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@contractai-review/shared": "workspace:*",
    "@huggingface/inference": "^4.13.13",
    "@nestjs/bullmq": "^10.1.1",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/typeorm": "^10.0.2",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "diff-match-patch-ts": "^0.8.0",
    "file-type": "^21.3.0",
    "ioredis": "^5.4.1",
    "openai": "^4.28.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-parse": "^1.1.1",
    "pdf2pic": "^3.1.2",
    "pg": "^8.13.1",
    "pgvector": "^0.2.0",
    "reflect-metadata": "^0.2.2",
    "replicate": "^1.4.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.5",
    "tesseract.js": "^5.1.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}